{
  "name": "gramene-atlas-heatmap",
  "version": "6.0.0",
  "description": "Warelab/Gramene fork of the EMBL-EBI Expression Atlas heatmap (atlas-heatmap 5.7.2): baseline and differential expression heatmaps for React 18 and react-bootstrap 2",
  "type": "module",
  "main": "./dist/gramene-atlas-heatmap.cjs",
  "module": "./dist/gramene-atlas-heatmap.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "import": {
        "types": "./dist/index.d.ts",
        "default": "./dist/gramene-atlas-heatmap.js"
      },
      "require": {
        "types": "./dist/index.d.cts",
        "default": "./dist/gramene-atlas-heatmap.cjs"
      }
    },
    "./style.css": "./dist/gramene-atlas-heatmap.css",
    "./dist/*": "./dist/*",
    "./package.json": "./package.json"
  },
  "sideEffects": [
    "*.css"
  ],
  "files": [
    "dist",
    "CHANGELOG.md",
    "NOTICE"
  ],
  "scripts": {
    "dev": "vite",
    "build": "rm -rf dist && vite build && node scripts/copy-dts.mjs && node scripts/check-dist.mjs",
    "test": "vitest run",
    "test:watch": "vitest",
    "fixtures": "node scripts/capture-fixtures.mjs",
    "lint:pkg": "node scripts/lint-pkg.mjs",
    "pack:local": "node scripts/check-release.mjs && npm run build && npm pack",
    "prepublishOnly": "node scripts/check-release.mjs && npm run build && npm test && npm run lint:pkg"
  },
  "peerDependencies": {
    "react": "^18.2.0",
    "react-bootstrap": "^2.7.0",
    "react-dom": "^18.2.0"
  },
  "dependencies": {
    "color": "^3.2.1",
    "downloadjs": "^1.4.7",
    "highcharts": "~6.2.0",
    "highcharts-custom-events": "~3.0.10",
    "highcharts-react-official": "^3.2.3",
    "lodash": "^4.17.21",
    "prop-types": "^15.8.1",
    "uncontrollable": "^7.2.1",
    "urijs": "^1.19.11"
  },
  "devDependencies": {
    "@arethetypeswrong/cli": "^0.18.5",
    "@testing-library/dom": "^10.4.1",
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^16.3.3",
    "@testing-library/user-event": "^14.6.1",
    "bootstrap": "^5.3.8",
    "jsdom": "^27.4.0",
    "publint": "^0.3.24",
    "react": "^18.3.1",
    "react-bootstrap": "^2.10.10",
    "react-dom": "^18.3.1",
    "vite": "^7.3.6",
    "vitest": "^4.1.11"
  },
  "author": "Expression Atlas developers <atlas-developers@ebi.ac.uk>",
  "contributors": [
    "Monica Jianu <monica@ebi.ac.uk>",
    "Lingyun Zhao <lingyun@ebi.ac.uk>",
    "Alfonso Muñoz-Pomer Fuentes <amunoz@ebi.ac.uk>",
    "Haider Iqbal <haideri@ebi.ac.uk>",
    "Andrew Olson (Gramene fork)"
  ],
  "license": "Apache-2.0",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/warelab/atlas-heatmap.git"
  },
  "bugs": {
    "url": "https://github.com/warelab/atlas-heatmap/issues"
  },
  "homepage": "https://github.com/warelab/atlas-heatmap#readme",
  "keywords": [
    "expression-atlas",
    "heatmap",
    "highcharts",
    "anatomogram",
    "gramene",
    "react-component"
  ]
}
